{
  "name": "UserPoints",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Total de pontos acumulados (saldo atual)"
    },
    "lifetime_points": {
      "type": "number",
      "default": 0,
      "description": "Total hist\u00f3rico de pontos ganhos (nunca diminui)"
    },
    "voucher_points": {
      "type": "number",
      "default": 0,
      "description": "Pontos acumulados por vouchers resgatados"
    },
    "referral_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico de indica\u00e7\u00e3o do usu\u00e1rio"
    },
    "total_referrals": {
      "type": "number",
      "default": 0,
      "description": "Total de indica\u00e7\u00f5es realizadas"
    },
    "successful_referrals": {
      "type": "number",
      "default": 0,
      "description": "Indica\u00e7\u00f5es que resultaram em assinatura"
    }
  },
  "required": [
    "user_email",
    "referral_code"
  ]
}