{
  "name": "UserPoints",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Total de pontos acumulados (saldo atual)"
    },
    "lifetime_points": {
      "type": "number",
      "default": 0,
      "description": "Total hist\u00f3rico de pontos ganhos (nunca diminui)"
    },
    "voucher_points": {
      "type": "number",
      "default": 0,
      "description": "Pontos acumulados por vouchers resgatados"
    },
    "referral_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico de indica\u00e7\u00e3o do usu\u00e1rio"
    },
    "total_referrals": {
      "type": "number",
      "default": 0,
      "description": "Total de indica\u00e7\u00f5es realizadas"
    },
    "successful_referrals": {
      "type": "number",
      "default": 0,
      "description": "Indica\u00e7\u00f5es que resultaram em assinatura"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o opcional"
    }
  },
  "required": [
    "user_email",
    "referral_code"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}