{
  "name": "StampCardConfig",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "ID do parceiro"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Programa de selos ativo"
    },
    "stamps_goal": {
      "type": "number",
      "default": 5,
      "description": "Quantos selos para completar o cart\u00e3o"
    },
    "discount_options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de descontos surpresa poss\u00edveis (ex: ['10% OFF', '15% OFF', 'Caf\u00e9 Gr\u00e1tis'])"
    },
    "reward_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do pr\u00eamio exibida ao usu\u00e1rio (sem revelar o valor)"
    }
  },
  "required": [
    "partner_id"
  ]
}