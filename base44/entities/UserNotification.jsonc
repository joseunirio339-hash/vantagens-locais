{
  "name": "UserNotification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio destinat\u00e1rio"
    },
    "type": {
      "type": "string",
      "enum": [
        "voucher_expiring",
        "new_coupon",
        "level_up",
        "badge_earned",
        "appointment_confirmed",
        "appointment_cancelled"
      ],
      "description": "Tipo de notifica\u00e7\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo"
    },
    "message": {
      "type": "string",
      "description": "Mensagem"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "reference_id": {
      "type": "string",
      "description": "ID do voucher, produto, conquista ou agendamento relacionado"
    }
  },
  "required": [
    "user_email",
    "type",
    "title",
    "message"
  ]
}