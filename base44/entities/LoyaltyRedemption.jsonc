{
  "name": "LoyaltyRedemption",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que resgatou"
    },
    "reward_id": {
      "type": "string",
      "description": "ID da recompensa resgatada"
    },
    "partner_id": {
      "type": "string",
      "description": "ID do parceiro"
    },
    "partner_owner_email": {
      "type": "string",
      "description": "Email do dono da loja (para o parceiro ver os resgates do seu neg\u00f3cio)"
    },
    "points_spent": {
      "type": "number",
      "description": "Pontos gastos no resgate"
    },
    "redemption_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico para apresentar ao parceiro"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "used",
        "expired",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status do resgate"
    },
    "reward_title": {
      "type": "string",
      "description": "T\u00edtulo da recompensa (snapshot)"
    },
    "partner_name": {
      "type": "string",
      "description": "Nome do parceiro (snapshot)"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Validade do c\u00f3digo de resgate"
    },
    "used_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de uso"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o opcional"
    }
  },
  "required": [
    "user_email",
    "reward_id",
    "partner_id",
    "points_spent",
    "redemption_code",
    "reward_title",
    "partner_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.partner_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.partner_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.partner_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}