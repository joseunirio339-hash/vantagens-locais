{
  "name": "Raffle",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "ID do parceiro que criou o sorteio"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do sorteio"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do sorteio"
    },
    "prizes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          }
        }
      },
      "description": "Lista de pr\u00eamios da roleta com peso de probabilidade"
    },
    "vouchers_per_spin": {
      "type": "number",
      "default": 1,
      "description": "Quantos vouchers usados s\u00e3o necess\u00e1rios para girar"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Sorteio ativo"
    },
    "ends_at": {
      "type": "string",
      "format": "date",
      "description": "Data de encerramento"
    }
  },
  "required": [
    "partner_id",
    "title",
    "prizes"
  ]
}