{
  "name": "Notification",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "ID do parceiro destinat\u00e1rio"
    },
    "partner_owner_email": {
      "type": "string",
      "description": "Email do dono da loja (para o parceiro acessar as notifica\u00e7\u00f5es do seu neg\u00f3cio)"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_voucher",
        "voucher_used",
        "new_review",
        "subscription_expiring"
      ],
      "description": "Tipo de notifica\u00e7\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da notifica\u00e7\u00e3o"
    },
    "message": {
      "type": "string",
      "description": "Mensagem da notifica\u00e7\u00e3o"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Lida ou n\u00e3o"
    },
    "reference_id": {
      "type": "string",
      "description": "ID do objeto relacionado (voucher, review, etc)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o opcional"
    }
  },
  "required": [
    "partner_id",
    "type",
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.partner_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.partner_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.partner_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}