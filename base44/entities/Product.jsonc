{
  "name": "Product",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "ID do parceiro lojista"
    },
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem do produto"
    },
    "category": {
      "type": "string",
      "enum": [
        "alimentacao",
        "moda",
        "eletronicos",
        "beleza",
        "saude",
        "mercado",
        "servicos",
        "lazer",
        "outros"
      ],
      "description": "Categoria do produto"
    },
    "original_price": {
      "type": "number",
      "description": "Pre\u00e7o original"
    },
    "discount_price": {
      "type": "number",
      "description": "Pre\u00e7o com desconto"
    },
    "discount_percentage": {
      "type": "number",
      "description": "Percentual de desconto"
    },
    "coupon_expires_at": {
      "type": "string",
      "format": "date",
      "description": "Data de validade do cupom"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Produto ativo"
    },
    "views_count": {
      "type": "number",
      "default": 0,
      "description": "Contador de visualiza\u00e7\u00f5es"
    }
  },
  "required": [
    "partner_id",
    "name",
    "original_price",
    "discount_price"
  ]
}