{
  "name": "ProductView",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID do produto visualizado"
    },
    "partner_id": {
      "type": "string",
      "description": "ID do parceiro"
    },
    "partner_owner_email": {
      "type": "string",
      "description": "Email do dono da loja (para o parceiro ver as visualiza\u00e7\u00f5es do seu neg\u00f3cio)"
    },
    "partner_owner_ref": {
      "type": "string",
      "description": "Identificador interno do dono da loja (vincula as visualiza\u00e7\u00f5es ao painel do parceiro)"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que visualizou"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o opcional"
    }
  },
  "required": [
    "product_id",
    "partner_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.partner_owner_email": "{{user.email}}"
        },
        {
          "data.partner_owner_ref": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.partner_owner_email": "{{user.email}}"
        },
        {
          "data.partner_owner_ref": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.partner_owner_email": "{{user.email}}"
        },
        {
          "data.partner_owner_ref": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}