{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "ID do parceiro"
    },
    "user_email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "user_phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "service_name": {
      "type": "string",
      "description": "Nome do servi\u00e7o agendado"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do agendamento"
    },
    "time": {
      "type": "string",
      "description": "Hor\u00e1rio do agendamento (ex: 14:00)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending",
      "description": "Status do agendamento"
    },
    "duration_minutes": {
      "type": "number",
      "default": 60,
      "description": "Dura\u00e7\u00e3o do servi\u00e7o em minutos"
    }
  },
  "required": [
    "partner_id",
    "user_email",
    "date",
    "time",
    "service_name"
  ]
}