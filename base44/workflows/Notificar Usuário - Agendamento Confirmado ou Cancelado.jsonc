{
  "name": "Notificar Usu\u00e1rio - Agendamento Confirmado ou Cancelado",
  "description": "Quando um agendamento muda para 'confirmed' ou 'cancelled', notifica o usu\u00e1rio",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"confirmed\" or .trigger.data.status == \"cancelled\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Appointment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_usu_rio_agendamento_confirmado_ou_cancelado",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAppointmentConfirmed",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyAppointmentConfirmed"
  }
}