{
  "name": "Recompensar Indica\u00e7\u00e3o ao Assinar",
  "description": "Quando uma assinatura muda para status 'active', verifica se o usu\u00e1rio foi indicado e recompensa o indicador",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"active\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Subscription"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recompensar_indica_o_ao_assinar",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "referralReward",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "referralReward"
  }
}