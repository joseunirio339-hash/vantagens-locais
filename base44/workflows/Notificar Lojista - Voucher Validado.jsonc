{
  "name": "Notificar Lojista - Voucher Validado",
  "description": "Quando um voucher \u00e9 marcado como usado, envia notifica\u00e7\u00e3o in-app e e-mail ao lojista",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"used\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Voucher"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_lojista_voucher_validado",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPartner",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyPartner"
  }
}